<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D14"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SPYDY REMINDER"
        android:textColor="#E62429"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Android Edition — Spider-Man Reminders"
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="30dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="REMINDER MESSAGE"
        android:textColor="#F0F4F8"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161B26"
        android:textColor="#FFFFFF"
        android:padding="14dp"
        android:hint="Time to drink water! 💧"
        android:textColorHint="#64748B"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CUSTOM DELAY (MINUTES)"
        android:textColor="#F0F4F8"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etMinutes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161B26"
        android:textColor="#FFFFFF"
        android:padding="14dp"
        android:inputType="numberDecimal"
        android:text="10"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnSetCustom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SET REMINDER"
        android:backgroundTint="#00D2FF"
        android:textColor="#000000"
        android:textStyle="bold"
        android:padding="14dp" />

    <Button
        android:id="@+id/btnTestDrop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🕷️ TEST DROP OVERLAY NOW"
        android:backgroundTint="#E62429"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:padding="14dp"
        android:layout_marginTop="16dp" />

</LinearLayout>
